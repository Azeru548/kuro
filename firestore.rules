rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasAll(['email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role in ['client', 'helper', 'both', 'admin'];
      allow update: if isSelf(uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
            || resource.data.role == request.resource.data.role);
    }

    match /helperProfiles/{uid} {
      allow read: if true;
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
    }

    match /requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.clientId == request.auth.uid;

      match /bids/{bidId} {
        allow read: if signedIn()
          && (resource.data.clientId == request.auth.uid
            || resource.data.helperId == request.auth.uid);
        // Prefer Admin SDK / API routes for bid create + status transitions
        allow write: if false;
      }
    }

    match /jobs/{jobId} {
      allow read: if signedIn()
        && (resource.data.clientId == request.auth.uid
          || resource.data.helperId == request.auth.uid);
      allow write: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn()
        && (resource.data.clientId == request.auth.uid
          || resource.data.helperId == request.auth.uid);

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
