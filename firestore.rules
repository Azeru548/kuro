rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasAll(['email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role in ['client', 'helper', 'both', 'admin'];
      allow update: if isSelf(uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
            || resource.data.role == request.resource.data.role);
    }

    match /helperProfiles/{uid} {
      allow read: if true;
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
    }

    match /requests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.offerPrice is number
        && request.resource.data.offerPrice > 0
        && request.resource.data.status == 'open';
      allow update: if signedIn()
        && resource.data.clientId == request.auth.uid;
    }

    // Top-level bids for simple queries by helperId / requestId / clientId
    match /bids/{bidId} {
      allow read: if signedIn()
        && (resource.data.clientId == request.auth.uid
          || resource.data.helperId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.helperId is string
        && request.resource.data.requestId is string
        && request.resource.data.offerPrice is number
        && request.resource.data.status == 'pending'
        && request.resource.data.helperId != request.auth.uid;

      // Client cancels pending bid
      allow update: if signedIn()
        && resource.data.status == 'pending'
        && (
          (
            resource.data.clientId == request.auth.uid
            && request.resource.data.status == 'cancelled'
            && request.resource.data.clientId == resource.data.clientId
            && request.resource.data.helperId == resource.data.helperId
            && request.resource.data.requestId == resource.data.requestId
          )
          ||
          // Helper accept / decline (Stage 3)
          (
            resource.data.helperId == request.auth.uid
            && request.resource.data.status in ['accepted', 'declined']
            && request.resource.data.helperId == resource.data.helperId
            && request.resource.data.clientId == resource.data.clientId
            && request.resource.data.requestId == resource.data.requestId
          )
        );
    }

    match /jobs/{jobId} {
      allow read: if signedIn()
        && (resource.data.clientId == request.auth.uid
          || resource.data.helperId == request.auth.uid);
      allow write: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn()
        && (resource.data.clientId == request.auth.uid
          || resource.data.helperId == request.auth.uid);
      allow create: if signedIn()
        && (request.resource.data.clientId == request.auth.uid
          || request.resource.data.helperId == request.auth.uid);

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
