rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /requests/{requestId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024;
    }

    match /jobs/{jobId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
